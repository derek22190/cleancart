{
  "manifest_version": 3,
  "name": "HeyBroc",
  "short_name": "HeyBroc",
  "version": "2.2.0",
  "description": "Automatic 0-100 ingredient scores and 1-tap Clean Swaps across online grocery stores.",
  "icons": {
    "16": "broc-mascot.png",
    "48": "broc-mascot.png",
    "128": "broc-mascot.png"
  },
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": [
    "*://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "HeyBroc settings", "default_popup": "popup.html", "default_icon": "broc-mascot.png" },
  "content_scripts": [
    {
      "matches": [
        "*://*.walmart.com/*",
        "*://*.instacart.com/*",
        "*://*.target.com/*",
        "*://*.kroger.com/*",
        "*://*.aldi.us/*",
        "*://*.doordash.com/*",
        "*://*.ubereats.com/*",
        "*://*.amazon.com/*",
        "*://*.wholefoodsmarket.com/*",
        "*://*.samsclub.com/*",
        "*://*.bjs.com/*",
        "*://*.costco.com/*",
        "*://*.shipt.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css", "broc-mascot.png"],
      "matches": [
        "*://*.walmart.com/*",
        "*://*.instacart.com/*",
        "*://*.target.com/*",
        "*://*.kroger.com/*",
        "*://*.aldi.us/*",
        "*://*.doordash.com/*",
        "*://*.ubereats.com/*",
        "*://*.amazon.com/*",
        "*://*.wholefoodsmarket.com/*",
        "*://*.samsclub.com/*",
        "*://*.bjs.com/*",
        "*://*.costco.com/*",
        "*://*.shipt.com/*"
      ]
    }
  ]
}
