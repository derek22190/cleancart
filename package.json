{
  "name": "cleancart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:rubric": "tsx scripts/test-rubric.ts",
    "audit:ai": "node scripts/ai-audit.mjs --engine=local",
    "audit:codex": "node scripts/ai-audit.mjs --engine=codex --skip-build",
    "audit:claude": "node scripts/ai-audit.mjs --engine=claude --skip-build",
    "ops": "tsx --conditions=react-server scripts/ops-cli.ts"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
