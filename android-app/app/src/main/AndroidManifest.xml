<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ package visibility: lets Swap Item target the store apps directly. -->
    <queries>
        <package android:name="com.walmart.android" />
        <package android:name="com.instacart.client" />
        <package android:name="com.target.ui" />
        <package android:name="com.kroger.mobile" />
        <package android:name="de.apptiv.business.android.aldi_us" />
        <package android:name="com.dd.doordash" />
        <package android:name="com.ubercab.eats" />
        <package android:name="com.amazon.mShop.android.shopping" />
        <package android:name="com.samsclub.app" />
        <package android:name="com.bjs.mobile" />
        <package android:name="com.costco.app.android" />
        <package android:name="com.shipt.groceries" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CleanCart"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".OverlayWindowService"
            android:exported="false" />

        <service
            android:name=".GroceryScreenReaderService"
            android:exported="false"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
